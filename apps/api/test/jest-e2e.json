{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@projeto-saas/database$": "<rootDir>/../../../packages/database/src",
    "^@projeto-saas/shared-types$": "<rootDir>/../../../packages/shared-types/src"
  }
}
