# ==============================================================================
# ProjetoSaaS — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================================

# ─── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projeto_saas?schema=public

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_REFRESH_EXPIRATION=14d
JWT_TEMP_SECRET=your-temp-secret-for-2fa-change-me
JWT_TEMP_EXPIRATION=5m

# ─── Two-Factor Authentication ───────────────────────────────────────────────
TWO_FACTOR_APP_NAME=ProjetoSaaS

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Redis (BullMQ) ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ─── Gemini / AI ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
