{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "plugin": ["opencode-agent-memory", "@tarquinen/opencode-smart-title", "opencode-wakatime"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "prisma": {
      "type": "remote",
      "url": "https://mcp.prisma.io/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true
    },
    "stripe": {
      "type": "local",
      "command": ["npx", "-y", "@stripe/agent-toolkit", "mcp"],
      "environment": {
        "STRIPE_SECRET_KEY": "{env:STRIPE_SECRET_KEY}"
      },
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp/",
      "enabled": false
    }
  },
  "lsp": {
    "tailwindcss": {
      "command": ["npx", "-y", "@tailwindcss/language-server", "--stdio"],
      "extensions": [".html", ".css", ".js", ".jsx", ".ts", ".tsx", ".vue"]
    }
  },
  "formatter": true,
  "permission": {
    "bash": {
      "pnpm *": "allow",
      "npx *": "allow",
      "turbo *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "*": "ask"
    }
  }
}
