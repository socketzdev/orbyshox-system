// ============================================================================
// ProjetoSaaS — Prisma Schema (SQLite)
// SQLite não suporta enums Prisma, então todos os campos enum são String.
// Os valores válidos são exportados de @projeto-saas/shared-types (ERP).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  phone           String?   @unique
  email           String?   @unique
  passwordHash    String
  name            String
  role            String    @default("TENANT_EMPLOYEE")
  tenantId        String?
  isActive        Boolean   @default(true)
  is2faEnabled    Boolean   @default(false)
  twoFactorSecret String?
  position        String?
  // Acúmulos de função em JSON (ex.: `["CLEANING"]`): somam permissões sem
  // trocar o cargo principal. Só via checkbox controlado na tela de equipe —
  // nunca texto livre, para a regra de segurança não depender de digitação.
  tags            String    @default("[]")
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  companyId String?
  roleId    String?

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleModel         Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  refreshTokens     RefreshToken[]
  recoveryCodes     RecoveryCode[]
  auditLogs         AuditLog[]         @relation("AuditAuthor")
  tenantNotes       TenantNote[]
  tenantAccessLogs  TenantAccessLog[]
  assignedTickets   Ticket[]           @relation("TicketAssignee")
  createdTickets    Ticket[]           @relation("TicketCreator")
  ticketMessages    TicketMessage[]
  knowledgeArticles KnowledgeArticle[]
  appointments      Appointment[]      @relation("StaffAppointments")
  cashRegisters     CashRegister[]     @relation("OpenedCashRegisters")
  settingsUpdated   SystemSetting[]    @relation("SettingUpdater")
  barberProfile     BarberProfile?     @relation("UserBarberProfile")
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  completedTasks    Task[]             @relation("TaskCompletedBy")

  @@index([tenantId])
  @@index([companyId])
  @@index([roleId])
  @@index([email])
  @@index([role])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

model RecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Tenants (Client Companies) ──────────────────────────────────────────────

model Tenant {
  id               String    @id @default(uuid())
  companyName      String
  tradeName        String?
  slug             String    @unique
  cnpj             String?   @unique
  niche            String    @default("BARBERSHOP")
  email            String
  phone            String?
  address          String?
  status           String    @default("TRIAL")
  stripeCustomerId String?   @unique
  trialEndsAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users                   User[]
  subscriptions           Subscription[]
  invoices                Invoice[]
  tickets                 Ticket[]
  notes                   TenantNote[]
  accessLogs              TenantAccessLog[]
  couponUsages            CouponUsage[]
  site                    TenantSite?
  productCategories       ProductCategory[]
  products                Product[]
  customers               Customer[]
  orders                  Order[]
  appointments            Appointment[]
  cashRegisters           CashRegister[]
  automationRules         AutomationRule[]
  automationNotifications AutomationNotification[]
  suppliers               Supplier[]
  nfeEntries              NfeEntry[]
  purchaseOrders          PurchaseOrder[]
  offlineQueue            OfflineSyncQueue[]
  stockBatches            StockBatch[]
  stockLosses             StockLoss[]
  stockMovements          StockMovement[]
  inventoryAudits         InventoryAudit[]
  billsPayable            BillPayable[]
  billsReceivable         BillReceivable[]
  receivablePayments      ReceivablePayment[]
  orderReturns            OrderReturn[]
  cashClosings            CashClosing[]
  storeSetting            StoreSetting?
  cashierTerminals        CashierTerminal[]
  cashMovements           CashMovement[]
  purchaseNotes           PurchaseNote[]
  tasks                   Task[]
  aiConversations         AiConversation[]
  services                Service[]
  calendarEvents          CalendarEvent[]
  gymStudents             GymStudent[]
  gymEnrollments          GymEnrollment[]
  gymCheckIns             GymCheckIn[]
  gymWorkouts             GymWorkout[]
  gymWorkoutItems         GymWorkoutItem[]
  gymExercises            GymExercise[]
  gymAssessments          GymAssessment[]
  gymClasses              GymClass[]
  gymClassBookings        GymClassBooking[]
  serviceEquipment        ServiceEquipment[]
  serviceOrders           ServiceOrder[]
  serviceQuotes           ServiceQuote[]

  @@index([niche])
  @@index([status])
  @@index([createdAt])
  @@index([stripeCustomerId])
}

model TenantSite {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  templateKey String   @default("minimal")
  theme       String   @default("{}")
  content     String   @default("{}")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([templateKey])
  @@index([isPublished])
}

model TenantNote {
  id        String   @id @default(uuid())
  tenantId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([tenantId])
}

model TenantAccessLog {
  id          String   @id @default(uuid())
  tenantId    String
  adminUserId String
  reason      String
  accessedAt  DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adminUser User   @relation(fields: [adminUserId], references: [id])

  @@index([tenantId])
  @@index([adminUserId])
}

// ─── Plans & Billing ─────────────────────────────────────────────────────────

model Plan {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?
  price           Int
  billingPeriod   String   @default("MONTHLY")
  maxUsers        Int      @default(1)
  maxUnits        Int      @default(1)
  isVisible       Boolean  @default(true)
  isArchived      Boolean  @default(false)
  stripePriceId   String?  @unique
  stripeProductId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]
  coupons       Coupon[]

  @@index([slug])
  @@index([isVisible, isArchived])
}

model PlanFeature {
  id           String  @id @default(uuid())
  planId       String
  featureKey   String
  featureLabel String
  enabled      Boolean @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([planId])
}

model Subscription {
  id                   String    @id @default(uuid())
  tenantId             String
  planId               String
  stripeSubscriptionId String?   @unique
  status               String    @default("TRIALING")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  cancelReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@index([status])
  @@index([stripeSubscriptionId])
}

model Invoice {
  id              String    @id @default(uuid())
  tenantId        String
  subscriptionId  String?
  stripeInvoiceId String?   @unique
  amountCents     Int
  discountCents   Int       @default(0)
  status          String    @default("PENDING")
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@index([stripeInvoiceId])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  discountType  String
  discountValue Int
  maxUses       Int?
  usedCount     Int       @default(0)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  planId        String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plan   Plan?         @relation(fields: [planId], references: [id])
  usages CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  tenantId  String
  appliedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([couponId, tenantId])
  @@index([couponId])
  @@index([tenantId])
}

model StripeEvent {
  id          String    @id
  type        String
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([processed])
}

// ─── Support & Tickets ──────────────────────────────────────────────────────

model Ticket {
  id                    String    @id @default(uuid())
  tenantId              String
  createdById           String
  assignedToId          String?
  subject               String
  category              String    @default("USAGE_QUESTION")
  priority              String    @default("MEDIUM")
  status                String    @default("OPEN")
  slaDeadline           DateTime?
  firstResponseAt       DateTime?
  closedAt              DateTime?
  lastCustomerMessageAt DateTime?
  slaState              String    @default("ON_TRACK")
  slaWarnedAt           DateTime?
  slaBreachedAt         DateTime?
  createdAt             DateTime  @default(now())
  resolvedAt            DateTime?
  updatedAt             DateTime  @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     User                  @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo    User?                 @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages      TicketMessage[]
  statusHistory TicketStatusHistory[]

  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([status, slaDeadline])
  @@index([assignedToId, status])
}

model TicketMessage {
  id             String   @id @default(uuid())
  ticketId       String
  authorId       String
  content        String
  isInternal     Boolean  @default(false)
  isFromCustomer Boolean  @default(false)
  createdAt      DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([ticketId, createdAt])
}

model TicketStatusHistory {
  id         String   @id @default(uuid())
  ticketId   String
  fromStatus String?
  toStatus   String
  actorId    String?
  reason     String?
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

model KnowledgeArticle {
  id          String   @id @default(uuid())
  title       String
  content     String
  category    String
  authorId    String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([category])
  @@index([isPublished])
}

// ─── Audit & Settings ───────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation("AuditAuthor", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id])

  @@index([key])
}

model EmailTemplate {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  variables String?
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ─── ERP Core Models ────────────────────────────────────────────────────────

model ProductCategory {
  id        String   @id @default(uuid())
  tenantId  String?
  companyId String?
  name      String
  color     String?
  sortOrder Int      @default(0)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@index([companyId])
}

model Product {
  id             String   @id @default(uuid())
  tenantId       String?
  companyId      String?
  categoryId     String?
  name           String
  description    String?
  sku            String?
  barcode        String?
  salePriceCents Int
  costPriceCents Int      @default(0)
  stockQuantity  Float    @default(0)
  minStockAlert  Float    @default(5)
  unit           String   @default("UN")
  brand          String?
  ncm            String?
  cest           String?
  origin         Int      @default(0)
  csosn          String?  @default("102")
  cstIcms        String?
  cstPis         String?  @default("01")
  cstCofins      String?  @default("01")
  cfopDefault    String?  @default("5102")
  packQuantity   Float    @default(1)
  imageUrl       String?
  isActive       Boolean  @default(true)
  isRecipe       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant            Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category          ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modifierGroups    ProductModifierGroup[]
  orderItems        OrderItem[]
  recipeItems       ProductIngredient[]    @relation("RecipeProduct")
  usedInRecipes     ProductIngredient[]    @relation("IngredientProduct")
  batches           StockBatch[]
  nfeItems          NfeEntryItem[]
  purchaseItems     PurchaseOrderItem[]
  suppliers         ProductSupplier[]
  stockLosses       StockLoss[]
  stockMovements    StockMovement[]
  auditItems        InventoryAuditItem[]
  barcodes          ProductBarcode[]
  serviceOrderItems ServiceOrderItem[]

  @@index([tenantId])
  @@index([companyId])
  @@index([tenantId, barcode])
}

model ProductIngredient {
  id             String @id @default(uuid())
  recipeId       String
  ingredientId   String
  quantityNeeded Float

  recipe     Product @relation("RecipeProduct", fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Product @relation("IngredientProduct", fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([ingredientId])
}

model Customer {
  id               String    @id @default(uuid())
  tenantId         String
  name             String
  phone            String?
  email            String?
  document         String?
  birthDate        DateTime?
  totalSpent       Int       @default(0)
  orderCount       Int       @default(0)
  lastOrderAt      DateTime?
  notes            String?
  creditLimitCents Int       @default(0)
  currentDebtCents Int       @default(0)
  loyaltyPoints    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders           Order[]
  appointments     Appointment[]
  billsReceivable  BillReceivable[]
  orderReturns     OrderReturn[]
  serviceEquipment ServiceEquipment[]
  serviceOrders    ServiceOrder[]
  serviceQuotes    ServiceQuote[]

  @@index([tenantId])
  @@index([tenantId, phone])
}

model Order {
  id             String   @id @default(uuid())
  tenantId       String?
  companyId      String?
  tableSessionId String?
  tableId        String?
  orderNumber    Int
  customerId     String?
  origin         String   @default("POS") // TABLET, QR_CODE, WAITER, POS
  status         String   @default("PENDING") // PENDING, PREPARING, READY, DELIVERED, COMPLETED, CANCELLED
  paymentMethod  String   @default("PIX")
  subtotalCents  Int      @default(0)
  discountCents  Int      @default(0)
  totalCents     Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Nome do garçom responsável (desnormalizado): o KDS mostra "buscar: X" e o
  // celular do garçom toca/vibra quando o pedido dele fica pronto. String livre
  // para não exigir vínculo com User (QR/tablet lançam sem login).
  waiterName     String?
  // Id do usuário que lançou/assumiu. O vínculo por ID é o que decide DE VERDADE
  // para quem apitar (nome pode repetir ou divergir do login). Sem FK de
  // propósito: QR/tablet não têm usuário e a exclusão de usuário nunca pode
  // travar ou apagar pedido.
  waiterId       String?

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  table           Table?           @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession    TableSession?    @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  returns         OrderReturn[]
  billsReceivable BillReceivable[]

  // Numeração sequencial por tenant: sem esta constraint, duas gravações
  // concorrentes que leem o mesmo `MAX(orderNumber)` geravam números repetidos
  // em silêncio (o banco aceitava). Com ela, a segunda falha com P2002 e o
  // serviço regenera o número — ver `withOrderNumberRetry`.
  // `tenantId` é anulável (pedidos de mesa/empresa); nesses casos o índice
  // não restringe, porque NULLs são distintos entre si.
  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([tableId])
  @@index([tableSessionId])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String
  quantity       Float
  unitPrice      Int     @default(0)
  unitPriceCents Int     @default(0)
  totalPrice     Int     @default(0)
  notes          String?

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model Appointment {
  id            String   @id @default(uuid())
  tenantId      String
  customerId    String
  staffId       String
  serviceName   String
  priceCents    Int
  scheduledAt   DateTime
  durationMin   Int      @default(30)
  status        String   @default("CONFIRMED")
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    User     @relation("StaffAppointments", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledAt])
  @@index([staffId, status, scheduledAt])
}

model CashRegister {
  id                  String    @id @default(uuid())
  tenantId            String
  openedById          String
  openedAt            DateTime  @default(now())
  closedAt            DateTime?
  initialBalanceCents Int       @default(0)
  finalBalanceCents   Int?
  actualBalanceCents  Int?
  status              String    @default("OPEN")
  notes               String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy  User           @relation("OpenedCashRegisters", fields: [openedById], references: [id], onDelete: Cascade)
  movements CashMovement[]

  @@index([tenantId])
}

model BarberProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  nickname             String?
  specialty            String?
  avatarColor          String   @default("#10b981")
  serviceCommissionPct Int      @default(50)
  productCommissionPct Int      @default(15)
  commissionOnFiado    String   @default("UPON_PAYMENT")
  monthlyGoalCents     Int      @default(0)
  workingHoursLabel    String?
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation("UserBarberProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Catálogo de serviços da casa (barbearia/salão): o que aparece no
// agendamento online e no atalho da Agenda. Preço/duração oficiais —
// o histórico de agendamentos só complementa o que não está aqui.
model Service {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  priceCents  Int      @default(0)
  durationMin Int      @default(30)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model AutomationRule {
  id        String    @id @default(uuid())
  tenantId  String
  trigger   String
  config    String    @default("{}")
  isEnabled Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AutomationNotification {
  id        String   @id @default(uuid())
  tenantId  String
  type      String
  title     String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isRead])
}

// ─── Marketplace (Fornecedores, Lotes, NF-e, Pedidos de Compra) ───────────────

model Supplier {
  id            String   @id @default(uuid())
  tenantId      String
  legalName     String
  tradeName     String?
  cnpj          String?
  email         String?
  phone         String?
  apiBaseUrl    String?
  apiAuthType   String?
  apiKeyCipher  String?
  leadTimeDays  Int      @default(3)
  minOrderCents Int      @default(0)
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products     ProductSupplier[]
  nfeEntries   NfeEntry[]
  orders       PurchaseOrder[]
  billsPayable BillPayable[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model ProductSupplier {
  id             String    @id @default(uuid())
  tenantId       String
  productId      String
  supplierId     String
  supplierSku    String?
  costCents      Int       @default(0)
  packSize       Int       @default(1)
  minOrderQty    Float     @default(1)
  isPreferred    Boolean   @default(false)
  lastPurchaseAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([tenantId])
  @@index([supplierId])
}

model StockBatch {
  id              String    @id @default(uuid())
  tenantId        String
  productId       String
  lotNumber       String
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantity        Float
  costCents       Int       @default(0)
  nfeEntryId      String?
  purchaseOrderId String?
  receivedAt      DateTime  @default(now())
  status          String    @default("ACTIVE")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  nfeEntry      NfeEntry?      @relation(fields: [nfeEntryId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@index([tenantId, expiryDate])
  @@index([status])
}

model NfeEntry {
  id         String   @id @default(uuid())
  tenantId   String
  supplierId String?
  // C7: era `@unique` global. Como a checagem de duplicidade não filtrava por
  // tenant, o tenant B recebia "já foi importada" para uma nota do tenant A —
  // vazamento de existência e bloqueio de importação legítima (reenvio do
  // fornecedor, XML repetido). A unicidade correta é por tenant.
  accessKey  String
  nfeNumber  String
  series     String
  issueDate  DateTime
  totalCents Int      @default(0)
  xmlRaw     String?
  status     String   @default("PENDING_RECONCILE")
  importedAt DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items          NfeEntryItem[]
  batches        StockBatch[]
  purchaseOrders PurchaseOrder[] @relation("NfeEntryPurchaseOrders")

  @@unique([tenantId, accessKey])
  @@index([tenantId, issueDate])
  @@index([tenantId, status])
}

model NfeEntryItem {
  id                 String  @id @default(uuid())
  nfeEntryId         String
  cProd              String
  xProd              String
  ncm                String?
  cfop               String?
  cEAN               String?
  uCom               String
  qCom               Float
  vUnCom             Int
  vProd              Int
  productId          String?
  reconciliationType String?

  nfeEntry NfeEntry @relation(fields: [nfeEntryId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([nfeEntryId])
  @@index([cEAN])
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  tenantId     String
  supplierId   String
  status       String    @default("DRAFT")
  totalCents   Int       @default(0)
  expectedDate DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]
  batches  StockBatch[]
  nfeLink  NfeEntry[]          @relation("NfeEntryPurchaseOrders")

  @@index([tenantId, status])
  @@index([supplierId, status])
}

model PurchaseOrderItem {
  id                String  @id @default(uuid())
  purchaseOrderId   String
  productId         String
  productSupplierId String?
  quantity          Float
  unitCostCents     Int
  totalCents        Int
  receivedQty       Float   @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model OfflineSyncQueue {
  id        String    @id @default(uuid())
  tenantId  String
  clientId  String
  payload   String
  kind      String
  status    String    @default("PENDING")
  error     String?
  createdAt DateTime  @default(now())
  syncedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId])
  @@index([tenantId, status])
  @@index([createdAt])
}

// ─── Supermarket & Retail Operations ─────────────────────────────────────────

model StockLoss {
  id           String   @id @default(uuid())
  tenantId     String
  productId    String
  quantity     Float
  reason       String // EXPIRED, DAMAGED, BREAKAGE, THEFT, DISCARD, OTHER
  costCents    Int      @default(0)
  notes        String?
  reportedById String?
  createdAt    DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([reason])
}

model StockMovement {
  id           String   @id @default(uuid())
  tenantId     String
  productId    String
  type         String // ENTRY_NFE, ENTRY_MANUAL, SALE_POS, LOSS_AVARIA, ADJUSTMENT, RETURN, TRANSFER
  quantity     Float
  balanceAfter Float
  referenceId  String?
  notes        String?
  operatorId   String?
  createdAt    DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([createdAt])
}

model InventoryAudit {
  id       String    @id @default(uuid())
  tenantId String
  status   String    @default("OPEN") // OPEN, COMPLETED, CANCELED
  openedAt DateTime  @default(now())
  closedAt DateTime?
  notes    String?

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  InventoryAuditItem[]

  @@index([tenantId, status])
}

model InventoryAuditItem {
  id          String @id @default(uuid())
  inventoryId String
  productId   String
  systemQty   Float
  countedQty  Float
  diffQty     Float  @default(0)

  inventory InventoryAudit @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([productId])
}

model BillPayable {
  id             String    @id @default(uuid())
  tenantId       String
  supplierId     String?
  description    String
  category       String    @default("FORNECEDOR") // FORNECEDOR, ALUGUEL, ENERGIA, AGUA, FOLHA, IMPOSTOS, MANUTENCAO, OUTROS
  amountCents    Int
  dueDate        DateTime
  paidAt         DateTime?
  status         String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELED
  notes          String?
  // Conta fixa/recorrente (aluguel, energia, internet): ao dar baixa, o
  // sistema gera sozinho a próxima ocorrência no `dueDay` do mês seguinte.
  isRecurring    Boolean   @default(false)
  // Dia do mês do vencimento recorrente (1-31). Nulo = conta avulsa.
  dueDay         Int?
  // Nota de compra que originou a despesa (baixa automática na confirmação).
  purchaseNoteId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([dueDate])
}

model BillReceivable {
  id                String    @id @default(uuid())
  tenantId          String
  customerId        String?
  orderId           String?
  description       String
  amountCents       Int
  paidCents         Int       @default(0)
  dueDate           DateTime
  receivedAt        DateTime?
  status            String    @default("PENDING") // PENDING, PARTIAL, RECEIVED, OVERDUE, CANCELED
  type              String    @default("FIADO") // FIADO, CREDIT_CARD, OUTROS
  // Parcelamento: N parcelas da mesma venda ligadas pelo groupId.
  installmentNumber Int?
  installmentsTotal Int?
  groupId           String?
  paymentMethod     String?
  purchaseDate      DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payments ReceivablePayment[]

  @@index([tenantId, status])
  @@index([dueDate])
  @@index([groupId])
  @@index([customerId])
}

// Histórico de recebimentos (inclusive parciais) de uma conta a receber.
model ReceivablePayment {
  id               String   @id @default(uuid())
  tenantId         String
  billReceivableId String
  amountCents      Int
  method           String?
  notes            String?
  operatorId       String?
  paidAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   BillReceivable @relation(fields: [billReceivableId], references: [id], onDelete: Cascade)

  @@index([billReceivableId])
  @@index([tenantId])
}

model OrderReturn {
  id               String   @id @default(uuid())
  tenantId         String
  orderId          String?
  customerId       String?
  reason           String
  refundMethod     String   @default("CREDIT") // CREDIT, CASH, PIX, REPLACEMENT
  totalRefundCents Int      @default(0)
  status           String   @default("COMPLETED")
  authorizedById   String?
  itemsSummary     String?
  createdAt        DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
}

model StoreSetting {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  storeName             String?
  legalName             String?
  cnpj                  String?
  stateRegistration     String?
  address               String?
  phone                 String?
  thermalPrinter        String   @default("80mm") // 58mm, 80mm, DISABLED
  fiscalType            String   @default("SIMPLES_NACIONAL") // SIMPLES_NACIONAL, LUCRO_PRESUMIDO, LUCRO_REAL
  nfceEnvironment       String   @default("HOMOLOGATION") // HOMOLOGATION, PRODUCTION
  nfceCscId             String?
  nfceCscToken          String?
  maxCashierDiscount    Int      @default(10)
  managerPin            String   @default("1234")
  enabledPaymentMethods String   @default("DINHEIRO,PIX,CARTAO_DEBITO,CARTAO_CREDITO,VALE,FIADO")
  // Chave PIX do recebedor usada para gerar o BR Code (QR) na tela de
  // pagamento. Guardada como digitada — a normalização (tirar máscara,
  // prefixar DDI) acontece na geração do QR, para não gravar um formato que
  // o dono não reconhece ao conferir depois.
  pixKey                String?
  // Nome do recebedor no BR Code. Campo obrigatório do padrão: quando vazio
  // cai no `storeName` e, se este também faltar, em "RECEBEDOR".
  pixReceiverName       String?
  // Cidade do recebedor. Campo obrigatório do padrão (máx. 15, ASCII).
  pixReceiverCity       String?
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CashierTerminal {
  id        String   @id @default(uuid())
  tenantId  String
  code      String // e.g. "PDV-01"
  name      String // e.g. "Caixa Rápido 01"
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ProductBarcode {
  id         String   @id @default(uuid())
  productId  String
  barcode    String
  type       String   @default("UNIT") // UNIT, PACK, BOX, DUN14
  multiplier Float    @default(1)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, barcode])
  @@index([barcode])
}

model CashMovement {
  id             String   @id @default(uuid())
  tenantId       String
  cashRegisterId String
  type           String // SANGRIA, SUPRIMENTO, COMPRA
  amountCents    Int
  reason         String
  operatorId     String?
  // Canal abatido (DINHEIRO/PIX/CARTAO_*) — preenchido em COMPRA de insumos.
  paymentMethod  String?
  // Nota de compra que originou o movimento (permite estornar ao reconfirmar).
  purchaseNoteId String?
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  @@index([tenantId, cashRegisterId])
}

// ─── Histórico de fechamentos de caixa ─────────────────────────────────────
// Cada "Salvar fechamento" grava uma foto do período (notas + totais +
// despesas + saldo em `snapshotJson`), para o proprietário consultar e
// REIMPRIMIR qualquer dia depois. Sem FK de usuário de propósito: apagar um
// usuário nunca pode levar o histórico junto.
model CashClosing {
  id                   String   @id @default(uuid())
  tenantId             String
  // TODAY, WEEK, MONTH
  period               String   @default("TODAY")
  periodStart          DateTime
  periodEnd            DateTime
  notesCount           Int      @default(0)
  grandTotalCents      Int      @default(0)
  totalsJson           String   @default("{}")
  expensesPaidCents    Int      @default(0)
  expensesPendingCents Int      @default(0)
  netTotalCents        Int      @default(0)
  // Foto completa (loja, notas, totais, despesas, alertas) em JSON.
  snapshotJson         String   @default("{}")
  createdByName        String?
  createdAt            DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, period])
}

// ─── Restaurant OS / Multi-Tenant Food Domain Models ─────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  cnpj      String?  @unique
  category  String   @default("BURGER_HOUSE") // BURGER_HOUSE, PIZZERIA, RESTAURANT, BAR, COFFEE_SHOP, JAPANESE, PASTRY
  plan      String   @default("PRO")
  active    Boolean  @default(true)
  branding  String   @default("{}") // JSON string: { primaryColor, logoUrl, font }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  roles              Role[]
  tables             Table[]
  devices            Device[]
  categories         ProductCategory[]
  products           Product[]
  tableSessions      TableSession[]
  orders             Order[]
  waiterCalls        WaiterCall[]
  purchaseNotes      PurchaseNote[]
  tasks              Task[]
  aiConversations    AiConversation[]
  tipConfig          TipConfig?
  serviceFeePayments ServiceFeePayment[]
  serviceFeePayouts  ServiceFeePayout[]

  @@index([slug])
  @@index([active])
}

model Role {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  permissions String   @default("[]") // JSON string of permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   User[]

  @@index([companyId])
}

model Table {
  id          String   @id @default(uuid())
  companyId   String
  number      Int
  label       String // ex: "Mesa 01"
  capacity    Int      @default(4)
  status      String   @default("FREE") // FREE, OCCUPIED
  qrTokenHash String // Hash SHA-256 do token opaco de QR code
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  devices            Device[]
  tableSessions      TableSession[]
  orders             Order[]
  waiterCalls        WaiterCall[]
  serviceFeePayments ServiceFeePayment[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([qrTokenHash])
}

model Device {
  id              String    @id @default(uuid())
  companyId       String
  tableId         String?
  name            String // ex: "Tablet Mesa 01", "KDS Cozinha"
  type            String    @default("TABLET") // TABLET, KDS, WAITER, POS
  tokenHash       String    @unique // Hash SHA-256 do Device Token
  status          String    @default("ACTIVE") // ACTIVE, REVOKED
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([tableId])
  @@index([tokenHash])
}

model ProductModifierGroup {
  id            String   @id @default(uuid())
  productId     String
  name          String // ex: "Ponto da Carne", "Adicionais", "Queijo"
  minSelectable Int      @default(0)
  maxSelectable Int      @default(1)
  isRequired    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   ProductModifierItem[]

  @@index([productId])
}

model ProductModifierItem {
  id         String   @id @default(uuid())
  groupId    String
  name       String // ex: "Ao Ponto", "Bacon Extra (+R$ 4,00)"
  priceCents Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group              ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
}

model TableSession {
  id            String    @id @default(uuid())
  companyId     String
  tableId       String
  status        String    @default("OPEN") // OPEN, CLOSED
  // Nome que o garçom dá à comanda ao abrir a mesa (ex.: "Mesa do João").
  // É o que o mapa de salão exibe no lugar de um "Ocupada" genérico.
  comandaName   String?
  // Garçom responsável pela mesa/comanda (vindo do usuário logado que abriu a
  // mesa ou lançou o pedido). Exibido no KDS para saber quem deve buscar.
  waiterName    String?
  // Id do usuário responsável (ver comentário em Order.waiterId).
  waiterId      String?
  // Quantidade de clientes informada na abertura. Já era enviada pelo front e
  // era descartada; passa a ser gravada junto, na mesma migração.
  customerCount Int?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Cascade (e não SetNull): `tableId` é obrigatório, então apagar a mesa leva
  // as comandas junto — SetNull aqui é inválido e o Prisma barra o schema.
  table      Table?             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders     Order[]
  serviceFee ServiceFeePayment?

  @@index([companyId])
  @@index([tableId])
  @@index([status])
}

// ─── Caixinha dos 10% (taxa de serviço) ────────────────────────────────────
// Dinheiro dos 10% NUNCA se mistura com o caixa da empresa: cada pagamento
// nasce vinculado a uma comanda real (tableSessionId único — sem nota, sem
// registro) e a divisão semanal baixa o saldo com trilha completa.
model TipConfig {
  id            String   @id @default(uuid())
  companyId     String   @unique
  // Taxa em basis points: 1000 = 10%.
  percentBps    Int      @default(1000)
  // Cargos que participam da divisão, em JSON (ex.: ["WAITER","KITCHEN"]).
  eligibleRoles String   @default("[\"WAITER\",\"KITCHEN\",\"CLEANING\"]")
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ServiceFeePayment {
  id                  String    @id @default(uuid())
  companyId           String
  // 1:1 com a comanda: o banco impede dois 10% na mesma nota e impede 10%
  // avulso (sem insert direto não há outro caminho de criação).
  tableSessionId      String    @unique
  tableId             String?
  clientName          String?
  orderNumbers        String    @default("[]")
  billTotalCents      Int       @default(0)
  suggestedCents      Int       @default(0)
  paidCents           Int       @default(0)
  // NOT_PAID (não pagou) · PAID (pagou) · OVER (pagou a mais) · UNDER (a menos)
  status              String    @default("NOT_PAID")
  paymentMethod       String?
  responsibleName     String?
  responsibleId       String?
  // Foto da nota no fechamento (itens, totais, mesa, horários): a verificação
  // usa o original, mesmo que o pedido seja corrigido depois no histórico.
  snapshotJson        String    @default("{}")
  // Trilha visível de ajustes (além do AuditLog): quem, quando, antes/depois e
  // motivo — motivo é obrigatório para editar ou excluir.
  editCount           Int       @default(0)
  lastEditBy          String?
  lastEditAt          DateTime?
  lastEditReason      String?
  lastEditBeforeCents Int?
  lastEditAfterCents  Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  table        Table?       @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, status])
}

model ServiceFeePayout {
  id               String   @id @default(uuid())
  companyId        String
  periodStart      DateTime
  periodEnd        DateTime
  totalCents       Int      @default(0)
  participantCount Int      @default(0)
  amountEachCents  Int      @default(0)
  // Sobra de centavos da divisão que permanece no caixa.
  remainderCents   Int      @default(0)
  // Foto: [{userId, name, role, amountCents}].
  participantsJson String   @default("[]")
  confirmedBy      String?
  confirmedByName  String?
  createdAt        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model OrderItemModifier {
  id             String @id @default(uuid())
  orderItemId    String
  modifierItemId String
  name           String
  priceCents     Int    @default(0)

  orderItem    OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierItem ProductModifierItem @relation(fields: [modifierItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([modifierItemId])
}

model WaiterCall {
  id         String    @id @default(uuid())
  companyId  String
  tableId    String
  type       String    @default("ASSISTANCE") // ASSISTANCE, BILL
  status     String    @default("PENDING") // PENDING, ANSWERED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  table   Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([tableId])
  @@index([status])
}

// ─── Módulo de Notas de Compra (ERP & Gastro) ─────────────────────────────────

model PurchaseNote {
  id            String    @id @default(uuid())
  tenantId      String?
  companyId     String?
  title         String    @default("Nota de Compra")
  status        String    @default("PENDING") // PENDING (🟡), IN_PROGRESS (🔵), CONFIRMED (🟢), PARTIAL (🟠)
  createdByName String? // ex: "Cozinheiro Carlos", "Chef Marcos"
  buyerName     String? // ex: "Comprador Marcos"
  notes         String? // Observações gerais da nota
  // Pagamento da compra (preenchido na confirmação): valor final gasto e
  // divisão por canal em JSON `[{method, amountCents}]` — único, combinado ou
  // espelhando o rateio por item. É o que abate cada saldo do caixa.
  totalCents    Int       @default(0)
  paymentsJson  String    @default("[]")
  // Quando foi pago/confirmado financeiramente (nulo = ainda não pago).
  paidAt        DateTime?
  // Fornecedor/origem da compra (texto livre, sem vínculo obrigatório).
  supplierName  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant  Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PurchaseNoteItem[]

  @@index([tenantId, status])
  @@index([companyId, status])
  @@index([createdAt])
}

model PurchaseNoteItem {
  id             String   @id @default(uuid())
  purchaseNoteId String
  itemName       String // ex: "Arroz", "Batata", "Tomate"
  quantity       String // ex: "2 sacos", "10 kg"
  status         String   @default("PENDING") // PENDING, BOUGHT (✅), NOT_BOUGHT (❌)
  buyerNotes     String? // ex: "Não consegui encontrar batata hoje."
  // Valor pago neste item + canal (rateio opcional por item; soma = total).
  priceCents     Int      @default(0)
  paymentMethod  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseNote PurchaseNote @relation(fields: [purchaseNoteId], references: [id], onDelete: Cascade)

  @@index([purchaseNoteId])
}

// ─── Operational Tasks & Routines ───────────────────────────────────────────

model Task {
  id           String  @id @default(uuid())
  tenantId     String?
  companyId    String?
  title        String
  description  String?
  assignedRole String? // "Garçom", "Cozinha", "Caixa", "Estoque", "Limpeza", "Todos"
  assignedToId String?
  createdById  String?

  frequency  String  @default("TODAY") // TODAY, DAILY, WEEKLY, CUSTOM_DAYS
  repeatDays String? // JSON array: '["SEG", "QUA", "SEX"]'

  triggerType  String   @default("TIME") // TIME, AFTER_CLOSING, BEFORE_OPENING, AFTER_LUNCH
  // Momento(s) de execução escolhidos. Permite combinar mais de um (ex: antes
  // da abertura E horário fixo) numa mesma rotina. Guardado como JSON array.
  // Ausente/vazio => usa apenas `triggerType`, mantendo as tarefas antigas válidas.
  triggerTypes String?
  dueTime      String? // ex: "22:30", "15:00", "08:00"
  dueDate      DateTime @default(now())

  priority            String  @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  requireConfirmation Boolean @default(false)

  isTemplate Boolean @default(false)
  templateId String?

  status          String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE
  completedAt     DateTime?
  completedById   String?
  completedByName String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo  User?    @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy User?    @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([companyId, status])
  @@index([dueDate])
  @@index([assignedToId])
  @@index([assignedRole])
}

// Eventos do Calendário da empresa (visão Google Calendar): compromissos,
// visitas, prazos. Recorrência simples em JSON; ocorrências são virtuais
// (expandidas na leitura) — editar "só este" gera cópia avulsa + exceção.
model CalendarEvent {
  id                   String   @id @default(uuid())
  tenantId             String
  title                String
  description          String?
  location             String?
  startsAt             DateTime
  endsAt               DateTime
  allDay               Boolean  @default(false)
  color                String   @default("#0E54F8")
  category             String   @default("Compromisso")
  recurrence           String? // JSON: {freq: DAILY|WEEKLY|MONTHLY|YEARLY, interval?, until?, count?}
  parentId             String? // cabeça da série quando for cópia avulsa de ocorrência
  recurrenceExceptions String? // JSON: ["2026-09-20T14:00:00.000Z", ...] (cabeça da série)
  reminderMin          Int? // 10, 60, 1440 (minutos antes)
  guests               String? // JSON: [{name, status: PENDING|ACCEPTED|DECLINED}]
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
}

// ─── Copiloto de IA: Histórico de Conversas ──────────────────────────────────

model AiConversation {
  id        String   @id @default(uuid())
  tenantId  String?
  companyId String?
  userId    String?
  title     String   @default("Nova conversa")
  model     String?
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([companyId, updatedAt])
  @@index([companyId, archived])
  @@index([userId])
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // user | model
  text           String
  thought        String?
  toolsUsed      String? // JSON serializado
  resultsSummary String? // JSON serializado
  modelUsed      String?
  usedFallback   Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Academia: gestão fitness ─────────────────────────────────────────────
// Vertical ACADEMIA (niche BARBERSHOP + Company.category = 'ACADEMIA').
// Aluno é entidade própria — não reaproveita Customer — porque matrícula,
// vencimento, check-in, treino e aula coletiva têm ciclo de vida fitness.

model GymStudent {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  document  String?
  birthDate DateTime?
  // ATIVO com mensalidade em dia | PENDENTE aguardando pagamento |
  // VENCIDO com mensalidade atrasada | PAUSADO matrícula pausada |
  // CANCELADO sem vínculo ativo
  status    String    @default("ATIVO")
  planName  String?
  dueDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments GymEnrollment[]
  checkIns    GymCheckIn[]
  workouts    GymWorkout[]
  assessments GymAssessment[]
  bookings    GymClassBooking[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

model GymEnrollment {
  id               String   @id @default(uuid())
  tenantId         String
  studentId        String
  plan             String
  startDate        DateTime
  endDate          DateTime
  priceCents       Int      @default(0)
  // ATIVA | PAUSADA | CANCELADA | EXPIRADA
  status           String   @default("ATIVA")
  // Conta a receber gerada na matrícula (integração com o Financeiro).
  billReceivableId String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student GymStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
}

model GymCheckIn {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String
  // MANUAL (recepção) | QR_CODE (catraca/app)
  method      String   @default("MANUAL")
  // BLOQUEADO registra tentativa de aluno irregular (catraca negada).
  blocked     Boolean  @default(false)
  blockReason String?
  createdAt   DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student GymStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([studentId])
}

model GymWorkout {
  id         String    @id @default(uuid())
  tenantId   String
  studentId  String
  title      String
  // SEG | TER | QUA | QUI | SEX | SAB | DOM — dia da ficha no programa semanal.
  dayOfWeek  String?
  // JSON legado: [{name, sets, reps, load}] — mantido para fichas antigas;
  // fichas novas usam os itens vinculados à biblioteca.
  exercises  String    @default("[]")
  coach      String?
  validUntil DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student GymStudent       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items   GymWorkoutItem[]

  @@index([tenantId])
  @@index([studentId])
}

// ─── Biblioteca de movimentos da academia ─────────────────────────────────
// Exercício base cadastrado pelo personal: nome formal, equipamento, grupo
// muscular e mídia de demonstração (URL de vídeo/GIF). A ficha do aluno
// referencia estes registros — nunca texto livre — para que cada movimento
// tenha sempre o vídeo de execução correta.

model GymExercise {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  equipment   String?
  // QUADRICEPS | POSTERIOR | GLUTEO | PEITORAL | COSTAS | OMBRO | BICEPS |
  // TRICEPS | ABDOMEN | PANTURRILHA | CARDIO | CORPO_INTEIRO | OUTRO
  muscleGroup String   @default("OUTRO")
  // URL de vídeo/GIF demonstrativo (YouTube ou arquivo direto).
  mediaUrl    String?
  // YOUTUBE | VIDEO | GIF — inferido no cadastro quando omitido.
  mediaType   String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  GymWorkoutItem[]

  @@index([tenantId])
  @@index([tenantId, muscleGroup])
  @@index([tenantId, name])
}

// ─── Item da ficha do aluno ───────────────────────────────────────────────
// Vínculo ficha ↔ movimento base, com prescrição individual do personal.
// Repetições validadas no serviço: 0–40.

model GymWorkoutItem {
  id          String   @id @default(uuid())
  tenantId    String
  workoutId   String
  exerciseId  String
  position    Int      @default(0)
  sets        Int      @default(3)
  reps        Int      @default(12)
  load        String?
  // Descanso em segundos entre séries.
  restSeconds Int?
  // Observações técnicas: cadência, amplitude, carga sugerida.
  notes       String?
  createdAt   DateTime @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workout  GymWorkout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise GymExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([workoutId])
  @@index([exerciseId])
}

// ─── Avaliação física completa ────────────────────────────────────────────
// Acompanhamento profissional do aluno: anamnese, antropometria, perimetria,
// dobras cutâneas (com cálculo por protocolo), bioimpedância, fotos de
// postura e evolução entre avaliações. Seções flexíveis em JSON tipado no
// serviço; IMC, RCQ e %G são calculados e persistidos a cada gravação.

model GymAssessment {
  id            String   @id @default(uuid())
  tenantId      String
  studentId     String
  date          DateTime @default(now())
  professional  String?
  // EMAGRECIMENTO | HIPERTROFIA | REABILITACAO | CONDICIONAMENTO | OUTRO
  goal          String?
  // JSON anamnese: {birthDate, age, sex, profession, emergencyContact,
  // injuries, surgeries, chronicPain, conditions[], medications,
  // limitations, activityLevel, trainingHistory, sleep, waterIntake, mainGoal}
  anamnesis     String   @default("{}")
  // Antropometria direta: altura, peso, envergadura, FC repouso, PA.
  heightCm      Float?
  weightKg      Float?
  wingspanCm    Float?
  restingHr     Int?
  systolic      Int?
  diastolic     Int?
  // JSON perimetria (cm): {neck, chest, waist, abdomen, hip, armRelaxedR,
  // armRelaxedL, armFlexedR, armFlexedL, forearmR, forearmL, thighProxR,
  // thighProxL, thighMedR, thighMedL, thighDistR, thighDistL, calfR, calfL}
  perimetry     String   @default("{}")
  // JSON dobras (mm): {triceps, biceps, subscapular, axillary, chest,
  // suprailiac, abdomen, thigh, calf}
  skinfolds     String   @default("{}")
  // JSON bioimpedância: {bodyFatPct, muscleMassKg, visceralFat, bmrKcal,
  // metabolicAge, bodyWaterPct}
  bioimpedance  String   @default("{}")
  // Protocolo de dobras: POLLOCK_3 | POLLOCK_7 | PETROSKI_4
  protocol      String?
  bodyDensity   Float?
  bodyFatPct    Float?
  bmi           Float?
  waistHipRatio Float?
  // JSON fotos de postura: {front, back, left, right} (dataURL imagem).
  photos        String   @default("{}")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student GymStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId, date])
}

model GymClass {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  coach       String?
  room        String?
  startsAt    DateTime
  durationMin Int      @default(60)
  capacity    Int      @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings GymClassBooking[]

  @@index([tenantId, startsAt])
}

model GymClassBooking {
  id        String   @id @default(uuid())
  tenantId  String
  classId   String
  studentId String
  // RESERVADO | PRESENTE | FALTOU | CANCELADO
  status    String   @default("RESERVADO")
  createdAt DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   GymClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student GymStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([tenantId])
  @@index([classId])
}

// ─── Refrigeração: ordens de serviço ──────────────────────────────────────
// Vertical REFRIGERACAO (niche BARBERSHOP + Company.category). A OS tem ciclo
// de vida próprio (ABERTA → AGENDADA → EM_ATENDIMENTO → AGUARDANDO_PECA →
// CONCLUIDA / CANCELADA) que tarefas genéricas não carregam: equipamento,
// diagnóstico, peças com baixa de estoque, fotos, técnico e valor que vira
// conta a receber ao concluir. Orçamento aprovado gera OS.

model ServiceEquipment {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String?
  clientName String?
  // SPLIT | JANELA | PORTATIL | GELADEIRA | FREEZER | BEBEDOURO | CAMARA_FRIA | OUTRO
  type       String   @default("SPLIT")
  brand      String?
  model      String?
  capacity   String?
  location   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders   ServiceOrder[]

  @@index([tenantId])
  @@index([customerId])
}

model ServiceOrder {
  id               String    @id @default(uuid())
  tenantId         String
  number           Int
  customerId       String?
  clientName       String
  phone            String?
  address          String?
  equipmentId      String?
  equipmentDesc    String?
  // INSTALACAO | MANUTENCAO | LIMPEZA | RECARGA | CONSERTO | VISITA
  serviceType      String    @default("MANUTENCAO")
  reportedProblem  String?
  diagnosis        String?
  performedService String?
  technicianId     String?
  technicianName   String?
  scheduledAt      DateTime?
  // ABERTA | AGENDADA | EM_ATENDIMENTO | AGUARDANDO_PECA | CONCLUIDA | CANCELADA
  status           String    @default("ABERTA")
  laborCents       Int       @default(0)
  partsCents       Int       @default(0)
  travelCents      Int       @default(0)
  discountCents    Int       @default(0)
  totalCents       Int       @default(0)
  // JSON: ["data:image/jpeg;base64,..."] — até 3 fotos do serviço.
  photos           String?
  billReceivableId String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  equipment ServiceEquipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  items     ServiceOrderItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([technicianId])
}

model ServiceOrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String?
  partName       String
  quantity       Float
  unitPriceCents Int     @default(0)
  totalCents     Int     @default(0)

  order   ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model ServiceQuote {
  id            String    @id @default(uuid())
  tenantId      String
  customerId    String?
  clientName    String
  phone         String?
  address       String?
  equipmentDesc String?
  laborCents    Int       @default(0)
  partsCents    Int       @default(0)
  travelCents   Int       @default(0)
  discountCents Int       @default(0)
  totalCents    Int       @default(0)
  // PENDENTE | APROVADO | RECUSADO | EXPIRADO
  status      String   @default("PENDENTE")
  validUntil  DateTime?
  // Agendamento da visita: definido no orçamento e herdado pela OS ao aprovar.
  scheduledAt DateTime?
  technicianId String?
  technicianName String?
  orderId     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([customerId])
}
